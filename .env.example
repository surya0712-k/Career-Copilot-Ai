# Google Gemini
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# Database (PostgreSQL — relational data only)
DATABASE_URL=postgresql+asyncpg://copilot:copilot@localhost:5432/career_copilot

# Qdrant (vector memory / RAG)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=career_memory

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/auth/callback

# JWT
JWT_SECRET=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# MCP
MCP_SERVER_URL=http://localhost:8080

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GITHUB_REDIRECT_URI=http://localhost:3001/auth/callback

# CORS
CORS_ORIGINS=http://localhost:3001
