# Azure AI Foundry — all LLM + embeddings (https://ai.azure.com)
# Deploy chat + embedding models, then copy endpoint URL, API key, and deployment names.
AZURE_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview
LLM_MODEL=your-chat-deployment-name
EMBEDDING_MODEL=your-embedding-deployment-name
EMBEDDING_DIMENSIONS=1536
# Performance tuning
FAST_ONBOARDING=true
DEFER_MEMORY_WRITES=true
SPLIT_ONBOARDING_PHASES=true
SKIP_WEB_RESEARCH=false
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=2048
LLM_ONBOARDING_MAX_TOKENS=1024
EMBEDDING_CACHE_SIZE=512

# Database (PostgreSQL — relational data only)
DATABASE_URL=postgresql+asyncpg://copilot:copilot@localhost:5432/career_copilot

# Qdrant (vector memory / RAG)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=career_memory_foundry

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/auth/callback

# JWT
JWT_SECRET=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# MCP
MCP_SERVER_URL=http://localhost:8080

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GITHUB_REDIRECT_URI=http://localhost:3001/auth/callback

# CORS
CORS_ORIGINS=http://localhost:3001

# LiveKit Cloud — voice STT/TTS (LLM uses Azure Foundry above)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_TTS_MODEL=cartesia/sonic-2

# MCP agent tools (optional auth for external callers)
MCP_API_KEY=
